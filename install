#!/usr/bin/env bash

################
### Symlinks ###
################

printf '\n\e[36mCreating symbolic links...\e[0m\n'

# dotfiles
files=(
    bash/bash_profile
    bash/bashrc
    gitconfig
    latexmkrc
    zsh/zshrc
    omp-themes
)

for file in "${files[@]}"; do
    ln -snfv "$PWD/$file" "$HOME/.${file##*/}"
done

# Files from the .config directory
mkdir -p "$HOME/.config" # create .config if it doesn't exist

files=(
    nvim
    fastfetch
    ghostty
)

for file in "${files[@]}"; do
    ln -snfv "$PWD/$file" "$HOME/.config/${file##*/}"
done

printf '\n\e[32mInstallation complete.\e[0m\n'
