{
  // ---------
  /// Editor
  // ---------

  "editor.fontSize": 15,
  "editor.fontFamily": "FiraCode Nerd Font",
  "editor.lineNumbers": "relative",

  "editor.insertSpaces": true,
  "editor.tabSize": 4,

  "editor.snippetSuggestions": "top",
  "editor.inlineSuggest.enabled": false,
  "editor.rulers": [80],
  "editor.minimap.enabled": false,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.formatOnSave": true,
  "editor.detectIndentation": false, // disable automatic indentation detection

  // --------
  /// Files
  // --------

  "files.insertFinalNewline": true,

  // -----------
  /// Terminal
  // -----------

  "terminal.integrated.fontSize": 15,
  "terminal.integrated.fontFamily": "FiraCode Nerd Font",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.allowChords": false,
  "terminal.integrated.stickyScroll.enabled": false,

  // ------------
  /// Workbench
  // ------------

  "workbench.iconTheme": "material-icon-theme",
  "workbench.colorTheme": "Tokyo Night Storm",
  "workbench.secondarySideBar.defaultVisibility": "hidden",

  // -------
  /// Chat
  // -------

  "chat.agent.enabled": false,
  "chat.titleBar.signIn.enabled": false,

  // ------------
  /// Formatter
  // ------------

  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
  },

  "[java]": {
    "editor.defaultFormatter": "redhat.java",
  },

  "[lua]": {
    "editor.defaultFormatter": "JohnnyMorganz.stylua",
  },

  "[c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
  },
  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
  },
  "C_Cpp.clang_format_style": "file",
  "C_Cpp.clang_format_fallbackStyle": "Microsoft",

  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
  },

  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
  },

  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },

  "[xml]": {
    "editor.defaultFormatter": "redhat.vscode-xml",
    "editor.tabSize": 2,
  },

  // ------
  /// Vim
  // ------

  "vim.leader": " ",
  "vim.highlightedyank.enable": true,
  // Let vscode handle these keybindings, not the vim extension
  "vim.handleKeys": {
    "<C-b>": false,
    "<C-f>": false,
    "<C-n>": false,
    "<C-p>": false,
  },
  "vim.normalModeKeyBindingsNonRecursive": [
    // --- Navigation --- //

    // Center cursor when half paging
    { "before": ["<C-d>"], "after": ["<C-d>", "z", "z"] },
    { "before": ["<C-u>"], "after": ["<C-u>", "z", "z"] },

    // Center cursor when navigating search results
    { "before": ["n"], "after": ["n", "z", "z", "z", "v"] },
    { "before": ["N"], "after": ["N", "z", "z", "z", "v"] },

    // Navigate between editor groups
    { "before": ["<C-l>"], "commands": ["workbench.action.focusRightGroup"] },
    { "before": ["<C-h>"], "commands": ["workbench.action.focusLeftGroup"] },
    { "before": ["<C-k>"], "commands": ["workbench.action.focusAboveGroup"] },
    { "before": ["<C-j>"], "commands": ["workbench.action.focusBelowGroup"] },

    // --- Coding --- //

    // Go to definition
    { "before": ["g", "d"], "commands": ["editor.action.revealDefinition"] },
    // Go to references
    { "before": ["g", "r"], "commands": ["editor.action.goToReferences"] },
    // Go to implementation
    { "before": ["g", "i"], "commands": ["editor.action.goToImplementation"] },

    // Show code actions
    { "before": ["<leader>", "a"], "commands": ["editor.action.codeAction"] },

    // Rename symbol
    { "before": ["<leader>", "r"], "commands": ["editor.action.rename"] },

    // Show hover information
    { "before": ["K"], "commands": ["editor.action.showHover"] },

    // Format document
    {
      "before": ["<leader>", "f"],
      "commands": ["editor.action.formatDocument"],
    },

    // Toggle line comment
    { "before": ["<leader>", "c"], "commands": ["editor.action.commentLine"] },

    // Yank to system clipboard
    { "before": ["<leader>", "y"], "after": ["\"", "+", "y"] },
  ],
  "vim.visualModeKeyBindingsNonRecursive": [
    // Stay in visual mode while moving selected lines up/down
    { "before": ["J"], "commands": ["editor.action.moveLinesDownAction"] },
    { "before": ["K"], "commands": ["editor.action.moveLinesUpAction"] },

    // Stay in visual mode while indenting
    { "before": ["<"], "commands": ["editor.action.outdentLines"] },
    { "before": [">"], "commands": ["editor.action.indentLines"] },

    // Toggle line comment
    { "before": ["<leader>", "c"], "commands": ["editor.action.commentLine"] },

    // Yank to system clipboard
    { "before": ["<leader>", "y"], "after": ["\"", "+", "y"] },
  ],
}
